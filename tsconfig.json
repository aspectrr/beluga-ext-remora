{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "declaration": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "paths": {
      "@beluga/sdk": ["../beluga/packages/sdk/src"],
      "@beluga/ext-host": ["../beluga-ext-host/index.ts"]
    }
  },
  "include": ["index.ts"],
  "exclude": ["node_modules", "dist", "cmd", "internal"]
}
